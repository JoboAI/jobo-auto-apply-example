# Server-side application credentials. Never expose these to the browser.
JOBO_API_KEY=jbe_test_replace_me
JOBO_API_BASE_URL=https://connect.jobo.world
OPENROUTER_API_KEY=
OPENROUTER_ANSWER_MODEL=~deepseek/deepseek-v4-flash-latest
OPENROUTER_RESUME_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_APP_NAME=Jobo Auto Apply
ANSWER_BUDGET_MS=45000

# Public HTTPS origin used by the application engine to fetch signed resumes.
PUBLIC_BASE_URL=https://demo.jobo.world
RESUME_URL_SIGNING_SECRET=

# Use independent random secrets with at least 32 characters.
# BETTER_AUTH_URL may be http://localhost:3000 for local development.
BETTER_AUTH_URL=https://demo.jobo.world
BETTER_AUTH_SECRET=
BREVO_API_KEY=
AUTH_EMAIL_FROM=noreply@jobo.world

DATA_DIR=./.data
WORKER_CONCURRENCY=2
WORKER_USER_CONCURRENCY=1
# Application destinations are additionally enforced in code, regardless of these flags.
DEFAULT_SANDBOX=true
RESTRICT_APPLY_HOSTS=true
ALLOWED_APPLY_HOSTS=sandbox.jobo.world
