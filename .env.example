# ─────────────────────────────────────────────────────────────────────────────
# Jobo Auto Apply
# ─────────────────────────────────────────────────────────────────────────────

# Your Jobo API key. Format: jbe_live_... or jbe_test_...
# Get one at https://enterprise.jobo.world/settings/api-keys
# NOTE: master keys (jobo-master-*) are rejected on Auto Apply routes.
JOBO_API_KEY=jbe_test_replace_me

# The public API host. You should not need to change this.
JOBO_API_BASE_URL=https://connect.jobo.world

# The account webhook signing secret, format whsec_...
#
# This is NOT self-serve yet. It is generated by the PORTAL API (a different
# host from JOBO_API_BASE_URL, authenticated with your portal session, not your
# API key) and revealed exactly once:
#
#   curl -X PUT https://enterprise.jobo.world/api/auto-apply/settings \
#     -H "Authorization: Bearer $PORTAL_JWT" \
#     -H "Content-Type: application/json" \
#     -d '{"default_callback_url":"https://<your-tunnel>/api/jobo/webhook"}'
#
# The `webhook_secret` field in that response is this value. See README §Setup.
JOBO_WEBHOOK_SECRET=whsec_replace_me

# ─────────────────────────────────────────────────────────────────────────────
# Your public origin
# ─────────────────────────────────────────────────────────────────────────────

# The public HTTPS origin Jobo will call back on, and where it will download
# resumes from. HARD REQUIREMENTS enforced by Jobo's SSRF guard:
#   - https (never http)
#   - port 443 only (an explicit :3000 or :8443 is rejected)
#   - DNS must resolve to a PUBLIC address (localhost / 10.x / 192.168.x fail)
#   - no redirects are followed
#
# In local development this is your tunnel origin. `npm run dev:tunnel` starts
# the tunnel and passes it to the dev server for you, and an environment value
# beats this file — so leave the line below alone unless you have a tunnel with
# a fixed hostname (see "A tunnel that survives restarts" in the README).
#   PUBLIC_BASE_URL=https://tidy-otter-1234.trycloudflare.com
#
# Restart the dev server after changing this — Next.js reads server env at boot.
PUBLIC_BASE_URL=https://replace-me.trycloudflare.com

# Secret used to sign the short-lived resume download URLs this app hands to
# Jobo. Any random string. Generate one with:  openssl rand -base64 32
RESUME_URL_SIGNING_SECRET=replace_me_with_32_random_bytes

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter
# ─────────────────────────────────────────────────────────────────────────────

OPENROUTER_API_KEY=sk-or-v1-replace_me

# Answers the ATS form. Runs inside a hard 120-second callback deadline, so
# latency matters more than raw capability here.
OPENROUTER_ANSWER_MODEL=google/gemini-2.0-flash

# Structures an uploaded resume into a profile. Runs once per resume with no
# clock pressure, so favour quality.
OPENROUTER_RESUME_MODEL=openai/gpt-4o-mini

# Optional attribution headers shown on your OpenRouter activity dashboard.
OPENROUTER_APP_NAME=Jobo Auto Apply Example
OPENROUTER_APP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Tuning
# ─────────────────────────────────────────────────────────────────────────────

# Ceiling on the answer-generation call, in ms. The real budget is
# min(this, deadline - now - reserve) where the deadline is 120s from the
# EVENT's created_at, not from when the request reached us.
#
# A fast model answers 20 fields in 3-8s. 45s is a generous ceiling that still
# leaves slack for Jobo's 5s/20s transport retries to be useful. Setting this
# near 100s means the first attempt eats the whole window.
ANSWER_BUDGET_MS=45000

# Where the SQLite database and uploaded resume PDFs live.
DATA_DIR=./.data

# Default state of the "sandbox" toggle on the apply form.
DEFAULT_SANDBOX=true
