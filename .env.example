# ─────────────────────────────────────────────────────────────────────────────
# Jobo Auto Apply
# ─────────────────────────────────────────────────────────────────────────────

# Your Jobo API key. Format: jbe_live_... or jbe_test_...
# Get one at https://enterprise.jobo.world/settings/api-keys
# NOTE: master keys (jobo-master-*) are rejected on Auto Apply routes.
JOBO_API_KEY=jbe_test_replace_me

# The public API host. You should not need to change this.
JOBO_API_BASE_URL=https://connect.jobo.world

# ─────────────────────────────────────────────────────────────────────────────
# Resume files (optional)
# ─────────────────────────────────────────────────────────────────────────────

# OPTIONAL. The whole synchronous loop — create, receive fields, answer,
# submit — works without any public origin. The one thing that needs it is
# `file` fields: Jobo downloads the resume from a public HTTPS URL this app
# serves. When unset, the answer engine skips file fields and records why in
# the per-field trace (an application that REQUIRES a resume will then cancel
# cleanly).
#
# If you set it, Jobo's SSRF guard enforces: https, port 443 only, DNS that
# resolves to a public address, no redirects. So a deployed origin works;
# localhost never will.
#   PUBLIC_BASE_URL=https://demo.example.com
PUBLIC_BASE_URL=

# Secret used to sign the short-lived resume download URLs this app hands to
# Jobo. Any random string. Generate one with:  openssl rand -base64 32
RESUME_URL_SIGNING_SECRET=replace_me_with_32_random_bytes

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter
# ─────────────────────────────────────────────────────────────────────────────

OPENROUTER_API_KEY=sk-or-v1-replace_me

# Answers the ATS form. Each answerable step has a hard deadline
# (answers_expire_at, ~3 minutes; 60s for one-time codes), so latency matters
# more than raw capability here.
OPENROUTER_ANSWER_MODEL=deepseek/deepseek-v4-flash-0731

# Structures an uploaded resume into a profile. Runs once per resume with no
# clock pressure, so you can afford something slower and stronger here than
# the answer model if you want to.
OPENROUTER_RESUME_MODEL=deepseek/deepseek-v4-flash-0731

# Optional attribution headers shown on your OpenRouter activity dashboard.
OPENROUTER_APP_NAME=Jobo Auto Apply Example
OPENROUTER_APP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Tuning
# ─────────────────────────────────────────────────────────────────────────────

# Ceiling on the answer-generation call, in ms. The real budget is
# min(this, answers_expire_at - now - reserve): a real browser is holding the
# employer's form open while your answers are produced, and missing the
# deadline fails the application with answers_timeout.
#
# A fast model answers 20 fields in 3-8s. 45s is a generous ceiling that still
# leaves room for the submit round-trip inside the ~3 minute step deadline.
ANSWER_BUDGET_MS=45000

# Where the SQLite database and uploaded resume PDFs live.
DATA_DIR=./.data

# Default state of the "sandbox" toggle on the apply form.
DEFAULT_SANDBOX=true

# ─────────────────────────────────────────────────────────────────────────────
#  Shared deployments
# ─────────────────────────────────────────────────────────────────────────────

# Refuse to create an application against any host outside
# ALLOWED_APPLY_HOSTS.
#
# Leave this false locally — you want the real thing. Turn it on wherever the
# person opening the page is not the person paying for the API key.
RESTRICT_APPLY_HOSTS=false

# Comma-separated hosts RESTRICT_APPLY_HOSTS permits. Matched on hostname
# EXACTLY, so neither sandbox.jobo.world.example.com nor notsandbox.jobo.world
# gets through. An entry starting with a dot (".example.com") is treated as a
# domain suffix instead.
#
# Widen it to accept real ATS boards — but understand what that means: a
# visitor can then submit a genuine application to a genuine employer using
# this deployment's API key and quota.
#   sandbox.jobo.world,jobs.ashbyhq.com,boards.greenhouse.io,boards.eu.greenhouse.io,job-boards.greenhouse.io,job-boards.eu.greenhouse.io
ALLOWED_APPLY_HOSTS=sandbox.jobo.world
