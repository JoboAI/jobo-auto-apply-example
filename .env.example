# Copy to .env.local and fill in. Every value is server-side only: never
# prefix any of these with NEXT_PUBLIC_. `npm run doctor` checks the result.
# Generate each secret separately, e.g. `openssl rand -hex 32`.

# ── Required ─────────────────────────────────────────────────────────────────

# Jobo API key with Auto Apply access (jbe_live_… or jbe_test_…). Sandbox mode
# applies with this key.
JOBO_API_KEY=jbe_test_replace_me

# OpenRouter: resume structuring and answer generation.
OPENROUTER_API_KEY=

# Postgres. `npm run db:up` starts this one (docker-compose.yml).
DATABASE_URL=postgres://auto_apply:auto_apply@127.0.0.1:5433/auto_apply

# Accounts (better-auth). BETTER_AUTH_URL is this app's own origin: account
# emails link to it. http is allowed only for localhost.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Account emails (verification, password reset) go out through Brevo.
# AUTH_EMAIL_FROM must be a sender verified in your Brevo account.
BREVO_API_KEY=
AUTH_EMAIL_FROM=you@example.com

# Signs the short-lived resume URLs Jobo downloads. At least 32 characters.
RESUME_URL_SIGNING_SECRET=

# ── Needed to complete applications ──────────────────────────────────────────

# This app's public HTTPS origin (port 443, no path). Jobo downloads resumes
# from it for resume upload fields, so localhost cannot work: use your
# deployed URL or an HTTPS tunnel to localhost:3000. Unset, the app runs but
# applications that ask for a resume stop. The health check requires it.
PUBLIC_BASE_URL=

# Resume PDFs. The web app and the worker must share this directory.
DATA_DIR=./.data

# ── Optional ─────────────────────────────────────────────────────────────────

# Enables production mode: visitors connect their own Jobo API key, which is
# stored encrypted with this, and apply to real jobs. At least 32 characters.
# Rotating it disconnects every stored key.
API_KEY_ENCRYPTION_SECRET=

# Jobo API origin.
JOBO_API_BASE_URL=https://connect.jobo.world
# Public list of the application systems Auto Apply supports (production mode).
# JOBO_STATUS_URL=https://enterprise.jobo.world/api/v1/public/status/uptime

# Models and routing (OpenRouter model ids).
OPENROUTER_ANSWER_MODEL=~deepseek/deepseek-v4-flash-latest
OPENROUTER_RESUME_MODEL=deepseek/deepseek-v4-flash-0731
# throughput | latency | price. Price routing can land on slow hosts.
OPENROUTER_PROVIDER_SORT=throughput
# Attribution headers OpenRouter shows in its dashboard.
OPENROUTER_APP_NAME=Jobo Auto Apply
# OPENROUTER_APP_URL=https://your-app.example.com
# Ceiling for one answer-model call, in ms.
ANSWER_BUDGET_MS=90000

# Applications running at once: across all workers, and per candidate.
WORKER_CONCURRENCY=2
WORKER_USER_CONCURRENCY=1

# Postgres connections per process.
# DATABASE_POOL_MAX=10
# debug | info | warn | error
# LOG_LEVEL=info

# The header carrying the real client IP, for sign-in rate limits. Set it only
# behind a proxy that overwrites that header on every request (e.g. nginx
# setting X-Real-IP); otherwise clients could pick their own IP.
# TRUSTED_IP_HEADER=x-real-ip
